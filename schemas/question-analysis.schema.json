{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hermes-manim-education/question-analysis.schema.json",
  "title": "QuestionAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "subject",
    "topic",
    "question_type",
    "objective",
    "given_data",
    "unknowns",
    "key_concepts",
    "ambiguities",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "exam": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "enum": [
        "mathematics",
        "physics"
      ]
    },
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_type": {
      "enum": [
        "multiple_choice",
        "open_ended",
        "unknown"
      ]
    },
    "statement": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "given_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "source_evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "constraints_and_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "description",
          "readability"
        ],
        "properties": {
          "input_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "readability": {
            "enum": [
              "clear",
              "partial",
              "unreadable",
              "not_applicable"
            ]
          },
          "extracted_information": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "irrelevant_or_contextual_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "ready_for_solution",
        "needs_review",
        "insufficient_information"
      ]
    }
  }
}
